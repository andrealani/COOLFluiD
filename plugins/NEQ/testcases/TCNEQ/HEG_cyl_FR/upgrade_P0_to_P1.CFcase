################################################################################
#
# Raises the converged P0 solution hegFR_P0.CFmesh to P1 by sampling the P0
# polynomial at the P1 solution points: writes heg_P1_init.CFmesh, the restart
# file of hegFR_P1.CFcase. Mesh preparation only,
# on ONE MPI rank: PLATO can be initialised only once per process.
#
# PLATO: set Plato.path below to your PLATO database directory.
#
################################################################################

CFEnv.ExceptionLogLevel   = 1000
CFEnv.ErrorOnUnusedConfig = false

Simulator.Modules.Libs = libCFmeshFileWriter libCFmeshFileReader \
                         libNavierStokes libNEQ libPlatoI \
                         libFluxReconstructionMethod libFluxReconstructionNavierStokes \
                         libFluxReconstructionNEQ

Simulator.Paths.WorkingDir = plugins/NEQ/testcases/TCNEQ/HEG_cyl_FR
Simulator.Paths.ResultsDir = plugins/NEQ/testcases/TCNEQ/HEG_cyl_FR

Simulator.SubSystems     = SubSysMesh
Simulator.SubSystemTypes = OnlyMeshSubSystem

Simulator.SubSysMesh.Namespaces = MeshNamespace
Simulator.SubSysMesh.MeshNamespace.MeshData          = MeshMeshData
Simulator.SubSysMesh.MeshNamespace.SubSystemStatus   = MeshSubSystemStatus
Simulator.SubSysMesh.MeshNamespace.PhysicalModelType = NavierStokes2DNEQ

Simulator.SubSysMesh.NavierStokes2DNEQ.refValues = 1. 1. 1. 1. 1. 5956. 5956. 1. 1.
Simulator.SubSysMesh.NavierStokes2DNEQ.PropertyLibrary    = Plato
Simulator.SubSysMesh.NavierStokes2DNEQ.Plato.mixtureName  = air5
Simulator.SubSysMesh.NavierStokes2DNEQ.Plato.reactionName = air5
Simulator.SubSysMesh.NavierStokes2DNEQ.Plato.transfName   = TTv
Simulator.SubSysMesh.NavierStokes2DNEQ.Plato.path         = /Users/rayan/PLATO/database
Simulator.SubSysMesh.NavierStokes2DNEQ.Plato.Xtol         = 1.e-100
Simulator.SubSysMesh.NavierStokes2DNEQ.nbSpecies      = 5
Simulator.SubSysMesh.NavierStokes2DNEQ.nbEulerEqs     = 3
Simulator.SubSysMesh.NavierStokes2DNEQ.nbVibEnergyEqs = 1

Simulator.SubSysMesh.MeshMeshData.listTRS    = Wall Inlet Outlet
Simulator.SubSysMesh.MeshMeshData.Namespaces = MeshNamespace

Simulator.SubSysMesh.OutputFormat      = CFmesh
Simulator.SubSysMesh.CFmesh.FileName   = heg_P1_init.CFmesh
Simulator.SubSysMesh.CFmesh.WriteSol   = WriteSolution
Simulator.SubSysMesh.CFmesh.Namespace  = MeshNamespace

Simulator.SubSysMesh.MeshCreator = CFmeshFileReader
Simulator.SubSysMesh.CFmeshFileReader.Data.FileName = hegFR_P0.CFmesh
Simulator.SubSysMesh.CFmeshFileReader.Namespace     = MeshNamespace

Simulator.SubSysMesh.SpaceMethod = Null
Simulator.SubSysMesh.Null.Builder = MeshUpgrade
Simulator.SubSysMesh.Null.MeshUpgrade.PolynomialOrder = P1
Simulator.SubSysMesh.Null.MeshUpgrade.UpgradeInit     = true
Simulator.SubSysMesh.Null.Namespace = MeshNamespace
