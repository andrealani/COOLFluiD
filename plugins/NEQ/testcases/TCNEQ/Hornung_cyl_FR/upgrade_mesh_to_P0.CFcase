################################################################################
# Converts the gmsh mesh hornung_cylinder.msh to CFmesh and sets the solution
# order to P0, the mesh hornungFR_P0.CFcase starts from.
#
# Reads  hornung_cylinder.msh
# Writes hornung_cylinder_P0.CFmesh
#
# Mesh preparation only, one MPI rank. PLATO can be initialised once per process,
# so this step cannot be folded into the solver cases as a second subsystem.
################################################################################

CFEnv.ExceptionLogLevel   = 1000
CFEnv.ErrorOnUnusedConfig = false

Simulator.Modules.Libs = libCFmeshFileWriter libCFmeshFileReader libGmsh2CFmesh \
                         libNavierStokes libNEQ libPlatoI \
                         libFluxReconstructionMethod libFluxReconstructionNavierStokes \
                         libFluxReconstructionNEQ

Simulator.Paths.WorkingDir = plugins/NEQ/testcases/TCNEQ/Hornung_cyl_FR
Simulator.Paths.ResultsDir = plugins/NEQ/testcases/TCNEQ/Hornung_cyl_FR

Simulator.SubSystems     = SubSysMesh
Simulator.SubSystemTypes = OnlyMeshSubSystem

Simulator.SubSysMesh.Namespaces = MeshNamespace
Simulator.SubSysMesh.MeshNamespace.MeshData          = MeshMeshData
Simulator.SubSysMesh.MeshNamespace.SubSystemStatus   = MeshSubSystemStatus
Simulator.SubSysMesh.MeshNamespace.PhysicalModelType = NavierStokes2DNEQ

Simulator.SubSysMesh.NavierStokes2DNEQ.refValues = 0.0001952 0.004956 5590. 5590. 1833. 1833.
Simulator.SubSysMesh.NavierStokes2DNEQ.PropertyLibrary    = Plato
Simulator.SubSysMesh.NavierStokes2DNEQ.Plato.mixtureName  = nitrogen2_nasa
Simulator.SubSysMesh.NavierStokes2DNEQ.Plato.reactionName = nitrogen2
Simulator.SubSysMesh.NavierStokes2DNEQ.Plato.transfName   = TTv
Simulator.SubSysMesh.NavierStokes2DNEQ.Plato.path         = /Users/rayan/PLATO_Install/database
Simulator.SubSysMesh.NavierStokes2DNEQ.Plato.Xtol         = 1.e-10
Simulator.SubSysMesh.NavierStokes2DNEQ.nbSpecies      = 2
Simulator.SubSysMesh.NavierStokes2DNEQ.nbEulerEqs     = 3
Simulator.SubSysMesh.NavierStokes2DNEQ.nbVibEnergyEqs = 1

Simulator.SubSysMesh.MeshMeshData.listTRS    = Wall Inlet Outlet
Simulator.SubSysMesh.MeshMeshData.Namespaces = MeshNamespace

Simulator.SubSysMesh.OutputFormat      = CFmesh
Simulator.SubSysMesh.CFmesh.FileName   = hornung_cylinder_P0.CFmesh
Simulator.SubSysMesh.CFmesh.WriteSol   = WriteSolution
Simulator.SubSysMesh.CFmesh.Namespace  = MeshNamespace

Simulator.SubSysMesh.MeshCreator = CFmeshFileReader
Simulator.SubSysMesh.CFmeshFileReader.Data.FileName = hornung_cylinder.CFmesh
Simulator.SubSysMesh.CFmeshFileReader.Namespace     = MeshNamespace
Simulator.SubSysMesh.CFmeshFileReader.convertFrom   = Gmsh2CFmesh

Simulator.SubSysMesh.SpaceMethod = Null
Simulator.SubSysMesh.Null.Builder = MeshUpgrade
Simulator.SubSysMesh.Null.MeshUpgrade.PolynomialOrder = P0
Simulator.SubSysMesh.Null.MeshUpgrade.UpgradeInit     = false
Simulator.SubSysMesh.Null.Namespace = MeshNamespace
