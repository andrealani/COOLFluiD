################################################################################
#
# EntropyMHD 3D: Dipole Corona (entropy-variable MHD + GLM)
# Flux Reconstruction P2, JFNK implicit, LaxFriedrichs Riemann flux
#
# Physical model: EntropyMHD3D; entropy variable sigma = p*rho^(1-gamma) replaces energy
# Eq 7: d(sigma)/dt + div(sigma*v) = 0 (pure conservation law, no source term)
# Pressure recovered as p = sigma*rho^(gamma-1) for momentum flux and eigenvalues
# Initial B: Dipole field (mZ = 0.222, B_pole ~ 1 Gauss)
# BCs: SuperInletEntropyMHD (inner, B=B_dipole), SuperOutletEntropyMHD (outer)
# Source: gravity in momentum only
#
################################################################################

CFEnv.ExceptionLogLevel    = 1000
CFEnv.DoAssertions         = true
CFEnv.AssertionDumps       = true
CFEnv.AssertionThrows      = true
CFEnv.AssertThrows         = true
CFEnv.AssertDumps          = true
CFEnv.ExceptionDumps       = true
CFEnv.ExceptionOutputs     = true
CFEnv.RegistSignalHandlers = false
CFEnv.OnlyCPU0Writes       = false

# SubSystem Modules
Simulator.Modules.Libs = libCFmeshFileWriter libCFmeshFileReader libParaViewWriter libCGNSWriter libTecplotWriter libEntropyMHD libFluxReconstructionMethod libFluxReconstructionEntropyMHD libFluxReconstructionPetsc libBackwardEuler libPetscI libNewtonMethod

# SubSystem Parameters
Simulator.Paths.WorkingDir = plugins/EntropyMHD/testcases/Dipole_FR
Simulator.Paths.ResultsDir = plugins/EntropyMHD/testcases/Dipole_FR

##################################################################
## SubSystemMesh: upgrade mesh to FR polynomial order           ##
##################################################################

Simulator.SubSystems     = SubSysMesh SubSystem
Simulator.SubSystemTypes = OnlyMeshSubSystem StandardSubSystem
Simulator.SubSysMesh.Namespaces = MeshNamespace
Simulator.SubSysMesh.Ranks = 0:0
Simulator.SubSysMesh.MeshNamespace.MeshData = MeshMeshData
Simulator.SubSysMesh.MeshNamespace.SubSystemStatus = MeshSubSystemStatus
Simulator.SubSysMesh.MeshNamespace.PhysicalModelType = EntropyMHD3D
Simulator.SubSysMesh.MeshMeshData.listTRS = Inlet Outlet
Simulator.SubSysMesh.MeshMeshData.Namespaces = MeshNamespace

Simulator.SubSysMesh.OutputFormat = CFmesh
Simulator.SubSysMesh.CFmesh.FileName = EntropyMHD3DUpgraded.CFmesh
Simulator.SubSysMesh.CFmesh.WriteSol = WriteSolution
Simulator.SubSysMesh.CFmesh.Namespace = MeshNamespace

Simulator.SubSysMesh.MeshCreator = CFmeshFileReader
# Mesh not bundled with the testcase: generate the Q2 prism spherical shell with
# tools/MeshGeneration/generate_spherical_shell_Q2.py (naming <n>x<m>-r<r>.CFmesh)
# and place it in this directory.
Simulator.SubSysMesh.CFmeshFileReader.Data.FileName = 40x1280.CFmesh
Simulator.SubSysMesh.CFmeshFileReader.Namespace = MeshNamespace

Simulator.SubSysMesh.SpaceMethod = Null
Simulator.SubSysMesh.Null.Builder = MeshUpgrade
Simulator.SubSysMesh.Null.MeshUpgrade.PolynomialOrder = P2
Simulator.SubSysMesh.Null.MeshUpgrade.UpgradeInit = false
Simulator.SubSysMesh.Null.Namespace = MeshNamespace

##################################
## SubSystem: FR solver         ##
##################################

Simulator.SubSystem.Default.PhysicalModelType = EntropyMHD3D

# gamma = 1.05 (polytropic)
Simulator.SubSystem.EntropyMHD3D.ConvTerm.gamma = 1.05

# GLM reference speed
Simulator.SubSystem.EntropyMHD3D.ConvTerm.refSpeed = 1.0

# Reference values for non-dimensionalization
Simulator.SubSystem.EntropyMHD3D.ConvTerm.nRef  = 1.0e14
Simulator.SubSystem.EntropyMHD3D.ConvTerm.BRef  = 2.2e-4
Simulator.SubSystem.EntropyMHD3D.ConvTerm.lRef  = 6.9551e8
Simulator.SubSystem.EntropyMHD3D.ConvTerm.TRef  = 1.5e6

#################
## Output      ##
#################

Simulator.SubSystem.OutputFormat = CFmesh CGNS

Simulator.SubSystem.CFmesh.FileName = dipole_EntropyMHD3D.CFmesh
Simulator.SubSystem.CFmesh.SaveRate = 100
Simulator.SubSystem.CFmesh.AppendTime = false
Simulator.SubSystem.CFmesh.AppendIter = false
Simulator.SubSystem.CFmesh.ParWriteSol = ParWriteSolution

Simulator.SubSystem.CGNS.FileName = dipole_EntropyMHD3D.cgns
Simulator.SubSystem.CGNS.Data.updateVar = Prim
Simulator.SubSystem.CGNS.WriteSol = ParCGNSHighOrderWriter
Simulator.SubSystem.CGNS.SaveRate = 50
Simulator.SubSystem.CGNS.AppendTime = false
Simulator.SubSystem.CGNS.AppendIter = true
#Simulator.SubSystem.CGNS.Data.DataHandleOutput.SocketNames = alpha smoothness
#Simulator.SubSystem.CGNS.Data.DataHandleOutput.VariableNames = alpha smoothness

#################
## Stop        ##
#################

Simulator.SubSystem.StopCondition = RelativeNormAndMaxIter
Simulator.SubSystem.RelativeNormAndMaxIter.MaxIter = 3000
Simulator.SubSystem.RelativeNormAndMaxIter.RelativeNorm = -7

#############################################
## NewtonIterator with JFNK               ##
#############################################

Simulator.SubSystem.ConvergenceMethod = NewtonIterator
Simulator.SubSystem.NewtonIterator.Data.CFL.ComputeCFL = Function
Simulator.SubSystem.NewtonIterator.Data.CFL.Function.Def = min(1000,1.*1.1^max(i-1,0))
Simulator.SubSystem.NewtonIterator.ConvergenceFile = convergence_EntropyMHD3D_JFNK.plt
Simulator.SubSystem.NewtonIterator.ShowRate = 1
Simulator.SubSystem.NewtonIterator.ConvRate = 1
Simulator.SubSystem.NewtonIterator.Data.DoComputeJacobian = false
Simulator.SubSystem.NewtonIterator.Data.MaxSteps = 1
Simulator.SubSystem.NewtonIterator.Data.PrintHistory = true

############################################
## JFNK Linear System + Preconditioner   ##
############################################

Simulator.SubSystem.LinearSystemSolver = PETSC
Simulator.SubSystem.LSSNames = NewtonIteratorLSS

# Jacobian-Free setup and solver
Simulator.SubSystem.NewtonIteratorLSS.SetupCom = ParJFSetup
Simulator.SubSystem.NewtonIteratorLSS.SysSolver = ParJFSolveSys

# Block-diagonal preconditioner
Simulator.SubSystem.NewtonIteratorLSS.Data.PCType = PCSHELL
Simulator.SubSystem.NewtonIteratorLSS.Data.ShellPreconditioner = FRP0Precond
Simulator.SubSystem.NewtonIteratorLSS.Data.KSPType = KSPGMRES
Simulator.SubSystem.NewtonIteratorLSS.Data.NbKrylovSpaces = 100
Simulator.SubSystem.NewtonIteratorLSS.Data.MaxIter = 1000
Simulator.SubSystem.NewtonIteratorLSS.Data.MatOrderingType = MATORDERING_RCM

# Eisenstat-Walker adaptive KSP tolerance
Simulator.SubSystem.NewtonIteratorLSS.ParJFSetup.UseEisenstatWalker = true

# Preconditioner options
Simulator.SubSystem.NewtonIteratorLSS.Data.FRP0Precond.BlockMode = ElementBlock
Simulator.SubSystem.NewtonIteratorLSS.Data.FRP0Precond.SmootherOmega = 1.0

################################
## FluxReconstruction Solver  ##
################################

Simulator.SubSystem.SpaceMethod = FluxReconstruction
Simulator.SubSystem.Default.listTRS = InnerCells Inlet Outlet

Simulator.SubSystem.MeshCreator = CFmeshFileReader
Simulator.SubSystem.CFmeshFileReader.Data.FileName = EntropyMHD3DUpgraded.CFmesh
Simulator.SubSystem.CFmeshFileReader.Data.CollaboratorNames = FluxReconstruction

# JFNK commands; standard FR (no EntropyMHD-specific overrides needed)
Simulator.SubSystem.FluxReconstruction.SpaceRHSJacobCom = RHSJacob
Simulator.SubSystem.FluxReconstruction.ConvSolveCom = ConvRHSJacob
Simulator.SubSystem.FluxReconstruction.TimeRHSJacobCom = PseudoSteadyTimeRHS
Simulator.SubSystem.FluxReconstruction.JacobianSparsity = CellCentered
Simulator.SubSystem.FluxReconstruction.SetupCom = SetupExtra
Simulator.SubSystem.FluxReconstruction.ExtrapolateCom = Null
Simulator.SubSystem.FluxReconstruction.FinalizeRHSCom = Null
Simulator.SubSystem.FluxReconstruction.Builder = StdBuilder

# Variable sets; UpdateVar=Prim (state stored as rho,u,v,w,B,sigma,phi), SolutionVar=Cons
# for proper pseudo-time conditioning (LF dissipation and time term scale with rho)
# Cons = (rho, rho*u, rho*v, rho*w, Bx, By, Bz, sigma, phi); sigma same in both, only v<->rho*v differs
Simulator.SubSystem.FluxReconstruction.Data.UpdateVar   = Prim
Simulator.SubSystem.FluxReconstruction.Data.SolutionVar = Cons
Simulator.SubSystem.FluxReconstruction.Data.LinearVar   = Cons
Simulator.SubSystem.FluxReconstruction.Data.RiemannFlux = LaxFriedrichsFlux

# FR discretization
Simulator.SubSystem.FluxReconstruction.Data.SolutionPointDistribution = GaussLegendre
Simulator.SubSystem.FluxReconstruction.Data.FluxPointDistribution = GaussLegendre
Simulator.SubSystem.FluxReconstruction.Data.CorrectionFunctionComputer = VCJH
Simulator.SubSystem.FluxReconstruction.Data.VCJH.CFactor = 0.0

############################################
## Order blending
############################################
#Simulator.SubSystem.FluxReconstruction.UseBlending = true
#Simulator.SubSystem.FluxReconstruction.PreProcessCom = OrderBlending
Simulator.SubSystem.FluxReconstruction.OrderBlending.UseLogScale = true
Simulator.SubSystem.FluxReconstruction.OrderBlending.S0 = 1.0
Simulator.SubSystem.FluxReconstruction.OrderBlending.Kappa = 1.0
Simulator.SubSystem.FluxReconstruction.OrderBlending.ModalMonitoredExpression = B2
Simulator.SubSystem.FluxReconstruction.OrderBlending.AlphaMin = 0.005
Simulator.SubSystem.FluxReconstruction.OrderBlending.AlphaMax = 1.0
Simulator.SubSystem.FluxReconstruction.OrderBlending.NeighborWeight = 0.5
Simulator.SubSystem.FluxReconstruction.OrderBlending.NbSweeps = 1

###########################
## Source: gravity only  ##
###########################

Simulator.SubSystem.FluxReconstruction.SrcTermNames = EntropyMHDSourceTerm
Simulator.SubSystem.FluxReconstruction.SrcTermComds = EntropyMHDSourceTerm
Simulator.SubSystem.FluxReconstruction.EntropyMHDSourceTerm.Gravity = true

Simulator.SubSystem.FluxReconstruction.EntropyMHDSourceTerm.DednerDamping = true
Simulator.SubSystem.FluxReconstruction.EntropyMHDSourceTerm.DednerCr = 0.18

###########################
## Boundary Conditions   ##
###########################

Simulator.SubSystem.FluxReconstruction.BcNames = Inlet Outlet
Simulator.SubSystem.FluxReconstruction.Inlet.applyTRS = Inlet
Simulator.SubSystem.FluxReconstruction.Outlet.applyTRS = Outlet

Simulator.SubSystem.FluxReconstruction.Data.BcTypes = SuperInletEntropyMHD SuperOutletEntropyMHD
Simulator.SubSystem.FluxReconstruction.Data.BcNames = Inlet         Outlet

# Inlet: fixed coronal base state
# mZ = 0.222 gives B_pole ~ 1 Gauss (matches init dipole field: 0.666 = 3*0.222)
Simulator.SubSystem.FluxReconstruction.Data.Inlet.rhoFixed = 1.0
Simulator.SubSystem.FluxReconstruction.Data.Inlet.pFixed = 0.108
Simulator.SubSystem.FluxReconstruction.Data.Inlet.mX = 0.0
Simulator.SubSystem.FluxReconstruction.Data.Inlet.mY = 0.0
Simulator.SubSystem.FluxReconstruction.Data.Inlet.mZ = 0.222

###########################
## Initial Condition     ##
###########################

# Parker wind init: (rho, u, v, w, Bx, By, Bz, sigma, phi) where sigma = p*rho^(1-gamma)
# sigma(r) = p0 * rho(r) where p0 = 0.108 (polytropic: sigma/rho = const along streamlines)
# rho(r), Vr(r)*x/r, Vr(r)*y/r, Vr(r)*z/r from Parker wind solution
# B = dipole field: B_i = (3*(m.r)*r_i - m_i*r^2) / r^5, with m = (0,0,mZ)
# phi = 0
Simulator.SubSystem.FluxReconstruction.InitComds = InitStateAddVar
Simulator.SubSystem.FluxReconstruction.InitNames = InField

Simulator.SubSystem.FluxReconstruction.InField.applyTRS = InnerCells
Simulator.SubSystem.FluxReconstruction.InField.InitVars = x y z
Simulator.SubSystem.FluxReconstruction.InField.Vars = x y z r
Simulator.SubSystem.FluxReconstruction.InField.InitDef = sqrt(x^2+y^2+z^2)

